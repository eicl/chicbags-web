# Copia este archivo a .env y completa los valores (no se sube a git).
# En Render, estas mismas claves se configuran como variables de entorno del servicio.

# Credenciales del admin, solo se usan para crear el usuario la primera vez
# que arranca el servidor (si todavía no hay ningún usuario en la base de datos).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Secreto para firmar las sesiones (JWT). Genera uno propio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cadena de conexión a la base de datos PostgreSQL (Render, Neon, Supabase, etc.).
DATABASE_URL=

# Credenciales de Izipay (pago con tarjeta en el checkout), desde el Back
# Office del vendedor. Mismo par de credenciales sirve para test o
# producción según cuál se ponga acá — el código no cambia entre ambientes.
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
# HMACSHA256 del Back Office: no lo usa el servidor todavía (ver comentario
# en server/index.js), pero se documenta acá por si hace falta más adelante.
IZIPAY_HMAC_KEY=
