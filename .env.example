# Copia este archivo a .env y completa los valores (no se sube a git).
# En Render, estas mismas claves se configuran como variables de entorno del servicio.

# Credenciales del admin, solo se usan para crear el usuario la primera vez
# que arranca el servidor (si todavía no hay ningún usuario en la base de datos).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Secreto para firmar las sesiones (JWT). Genera uno propio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cadena de conexión a la base de datos PostgreSQL (Render, Neon, Supabase, etc.).
DATABASE_URL=

# Credenciales de Izipay (pago con tarjeta en el checkout), desde el Back
# Office del vendedor. Mismo par de credenciales sirve para test o
# producción según cuál se ponga acá — el código no cambia entre ambientes.
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
# HMACSHA256 del Back Office: no lo usa el servidor todavía (ver comentario
# en server/index.js), pero se documenta acá por si hace falta más adelante.
IZIPAY_HMAC_KEY=

# URL pública del sitio (sin / al final) — se usa para armar el link de
# registro de pedido en el WhatsApp de bienvenida a un cliente nuevo.
SITE_URL=

# Credenciales de la API de WhatsApp de migo.pe (docs.migo.pe/v2), para
# mandar automáticamente las confirmaciones de registro/pedido y las
# actualizaciones de estado. Se obtienen creando y vinculando (por QR) una
# instancia en https://api.migo.pe/whatsapp.
MIGO_WHATSAPP_INSTANCE=
MIGO_WHATSAPP_APIKEY=

# Token de la consulta de DNI de migo.pe (docs.migo.pe/v2/dni/dni.md) — un
# servicio aparte del de WhatsApp de arriba, con su propio token Bearer.
# Autocompleta nombres/apellidos por DNI en el registro de cliente y el
# panel admin.
MIGO_API_TOKEN=

# Emisión de boletas electrónicas ante SUNAT (SEE - Del Contribuyente, ver
# server/sunat.js) — botón "Emitir boleta" en Admin > Pedidos.
# "beta" o "produccion". Default "beta" si se deja vacío o mal escrito, a
# propósito: un despliegue mal configurado nunca debe emitir documentos
# reales por accidente.
SUNAT_ENV=beta
# RUC del emisor (11 dígitos).
SUNAT_RUC=
# Razón social (nombre legal) y nombre comercial (si se deja vacío, se usa
# la razón social).
SUNAT_RAZON_SOCIAL=
SUNAT_NOMBRE_COMERCIAL=
# Dirección fiscal y su código de ubigeo SUNAT (6 dígitos).
SUNAT_DIRECCION_FISCAL=
SUNAT_UBIGEO=
# Serie de boleta (ej. B001).
SUNAT_SERIE_BOLETA=B001
# Usuario secundario SOL (sin el prefijo del RUC) con el permiso de
# "Emisor electrónico", y su contraseña — se crean en SUNAT Operaciones en
# Línea > Administración del RUC > Usuarios.
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
# Certificado digital .p12/.pfx en base64 (ej. `base64 -w0 certificado.p12`)
# y su contraseña — el usado para firmar cada boleta.
SUNAT_CERT_P12_BASE64=
SUNAT_CERT_PASSWORD=

# Respaldo automático del PDF de cada boleta aceptada en una carpeta de
# Google Drive. Usa OAuth a nombre del usuario (no una cuenta de servicio —
# Google ya no deja que una cuenta de servicio suba archivos a una Drive
# personal, cuota propia = 0 GB). Client ID/Secret de un OAuth Client
# (tipo "Desktop app") del mismo proyecto de Google Cloud, y un refresh
# token obtenido una sola vez con server/scripts/google-drive-authorize.mjs.
# Si se deja vacío, simplemente se omite el respaldo (la boleta se emite
# igual).
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
